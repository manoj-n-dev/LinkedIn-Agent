# .env.example — PLACEHOLDERS ONLY. Copy to .env and fill in YOUR OWN values.
# Never commit .env. Never put a real value in this file.
# The app (planned, FR-028) refuses to start while any required value is missing or still REPLACE_ME.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=REPLACE_ME            # from @BotFather
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME       # you make this up: 1-256 chars, A-Z a-z 0-9 _ -  (needed if you use a webhook)
OWNER_TELEGRAM_ID=REPLACE_ME             # your numeric Telegram user ID (use the local owner-ID helper)
OWNER_DISPLAY_NAME=                      # optional, used in greetings

# --- General ---
TIMEZONE=Asia/Kolkata                    # change to yours; the maintainer's default

# --- Database (required) ---
DATABASE_URL=REPLACE_ME                  # e.g. your own Supabase Postgres URL, or a local SQLite URL for testing

# --- AI (required: Groq; ONE account, ONE key) ---
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=REPLACE_ME                    # choose in the Groq console; limits are per organization
GEMINI_API_KEY=                          # optional fallback; free tier content may be used to improve Google products

# --- LinkedIn (all optional; without them the app runs in drafts-only mode) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=
TOKEN_ENCRYPTION_KEY=                    # required if you connect LinkedIn; keep separate from the database

# --- Safety switches ---
PUBLISHING_ENABLED=false                 # keep false until YOU tested the official posting route
KILL_SWITCH=false                        # true stops every LinkedIn-facing action
